{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "/vibe docs",
  "search": {
    "prompt": "Search /vibe docs"
  },
  "feedback": {
    "thumbsRating": true
  },
  "colors": {
    "primary": "#6B8FFF",
    "light": "#8BA8FF",
    "dark": "#5978D6"
  },
  "favicon": "/favicon.svg",
  "navigation": {
    "groups": [
      {
        "group": "Start",
        "pages": [
          "index",
          "quickstart",
          "buddy"
        ]
      },
      {
        "group": "Understand",
        "pages": [
          "how-it-works",
          "mcp-tools"
        ]
      },
      {
        "group": "Help improve /vibe",
        "pages": [
          "contributing"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Start /vibe",
          "href": "https://www.slashvibe.dev",
          "icon": "terminal"
        },
        {
          "anchor": "Vibe Buddy",
          "href": "https://www.slashvibe.dev/buddy",
          "icon": "display"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "slashvibe.dev",
        "href": "https://www.slashvibe.dev"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/VibeCodingInc/docs"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Start /vibe",
      "href": "https://www.slashvibe.dev"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "cursor",
      "mcp"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/VibeCodingInc"
    }
  },
  "redirects": [
    { "source": "/terminal-app", "destination": "/buddy" },
    { "source": "/ios-app", "destination": "/buddy" },
    { "source": "/guides/presence", "destination": "/how-it-works" },
    { "source": "/guides/messaging", "destination": "/how-it-works" },
    { "source": "/guides/watch-me-code", "destination": "/how-it-works" },
    { "source": "/guides/ide-support", "destination": "/quickstart" },
    { "source": "/guides/invite-friends", "destination": "/quickstart" },
    { "source": "/guides/genesis-handles", "destination": "/quickstart" },
    { "source": "/concepts/why-vibe", "destination": "/how-it-works" },
    { "source": "/concepts/the-terminal-party", "destination": "/how-it-works" },
    { "source": "/concepts/history", "destination": "/how-it-works" },
    { "source": "/concepts/mcp-explained", "destination": "/how-it-works" },
    { "source": "/concepts/agent-messaging", "destination": "/how-it-works" },
    { "source": "/building/mcp-tools", "destination": "/mcp-tools" },
    { "source": "/building/custom-integrations", "destination": "/contributing" },
    { "source": "/building/agent-development", "destination": "/contributing" },
    { "source": "/api-reference/:path*", "destination": "/how-it-works" }
  ]
}
